	@$(QMAKE) -o Makefile camera_display.pro

qmake_all: FORCE


all: Makefile camera_capture_v2

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/aarch64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents mainwindow.h pcie_device.h frame_buffer.h frame_capture.h image_converter.h obb_detector.h obb_postprocess.h overlay_renderer.h eglfs_video_window.h detection_worker.h video_frame_widget.h lprnet.h yolov8_detector.h lane_departure_analyzer.h yolov8_worker.h helmet_worker.h traffic_detector.h traffic_worker.h wifi_receiver.h ip_camera_receiver.h wifi_discovery.h wifi_control.h $(DISTDIR)/
	$(COPY_FILE) --parents main.cpp mainwindow.cpp pcie_device.cpp frame_capture.cpp image_converter.cpp obb_detector.cpp obb_postprocess.cpp overlay_renderer.cpp eglfs_video_window.cpp detection_worker.cpp video_frame_widget.cpp lprnet.cc plate_preprocess_rknn.cpp yolov8_detector.cpp lane_departure_analyzer.cpp yolov8_worker.cpp helmet_worker.cpp traffic_detector.cpp traffic_worker.cpp wifi_receiver.cpp ip_camera_receiver.cpp wifi_discovery.cpp wifi_control.cpp $(DISTDIR)/


